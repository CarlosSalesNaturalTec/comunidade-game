{
  "hosting": [
    {
      "target": "app-03",
      "public": "apps/app-03-gestao/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ]
    },
    {
      "target": "api",
      "public": "backend/publico-vazio",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "nucleo-comunidade-game",
            "region": "southamerica-east1"
          }
        }
      ]
    },
    {
      "target": "vitrine",
      "public": "apps/app-06-vitrine/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/guerreiros/**",
          "destination": "/app.html"
        },
        {
          "source": "/mestres/**",
          "destination": "/app.html"
        },
        {
          "source": "/apoiadores/**",
          "destination": "/app.html"
        },
        {
          "source": "**",
          "destination": "/app.html"
        }
      ],
      "headers": [
        {
          "source": "/guerreiros/**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        },
        {
          "source": "/mestres/**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        },
        {
          "source": "/apoiadores/**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        },
        {
          "source": "/app.html",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        }
      ]
    },
    {
      "target": "aula",
      "public": "apps/app-01-aula-presencial/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    },
    {
      "target": "jogo",
      "public": "jogos/app-04-arena/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    },
    {
      "target": "minhaarea",
      "public": "apps/app-05-guerreiro/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    },
    {
      "target": "responsavel",
      "public": "apps/app-07-responsaveis/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    },
    {
      "target": "apoiador",
      "public": "apps/app-08-apoiador/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    },
    {
      "target": "mestre",
      "public": "apps/app-09-mestre/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    }
  ]
}
