---
import { secaoInstitucionalDoBuild } from "../build/dados";
import { SecaoDeSolicitacaoDeDados } from "../formularios/SecaoDeSolicitacaoDeDados";
import { ApresentacaoDaSecao } from "../institucional/SecoesInstitucionais";
import Vitrine from "../layouts/Vitrine.astro";
/** O recorte **pesquisadores** (PRD-03 §5.2): entra direto pelas séries por
 * comunidade. Trocar de recorte muda a porta de entrada e a ordem, nunca o
 * conteúdo público disponível (`RF-03-26`). */
import { SecaoDaCobertura } from "../territorio/SecaoDaCobertura";
import { SecaoDeComunidades } from "../territorio/SecaoDeComunidades";

const contatos = await secaoInstitucionalDoBuild("contatos");
---

<Vitrine
  titulo="Séries do território e dados abertos — Comunidade Game"
  descricao="As séries temporais georreferenciadas coletadas pelas comunidades, a metodologia de cada recorte, a cobertura da Agenda 2030 e como solicitar o conjunto completo."
  recorteAtual="pesquisadores"
>
  <section>
    <h2>Séries do território e metodologia</h2>
    <SecaoDeComunidades client:visible />
  </section>
  <section><h2>Cobertura da Agenda 2030</h2><SecaoDaCobertura client:visible /></section>
  <section>
    <h2>Solicitação do conjunto de dados</h2>
    <SecaoDeSolicitacaoDeDados client:visible />
  </section>
  <section>
    <h2>Contatos</h2>
    <ApresentacaoDaSecao dado={contatos} nome="Contatos" />
  </section>
</Vitrine>
